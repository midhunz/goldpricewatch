# Canonical host is the apex, non-www (matches the canonical tags and sitemap).
#
# SEO_TASKS T0.4 found http://www -> https://www -> https://apex, a 2-hop chain.
# Claiming both schemes for the www host here collapses it to a single 301:
# without the http:// entry, Caddy's automatic HTTPS redirect fires first and
# adds the extra hop. Keep this block ahead of the apex block.
#
# NOTE: the deployed Caddyfile already redirects www (Caddy returns a valid 301
# with a valid certificate for www), but that block is not in this file — this
# repo's config has drifted from production. Reconcile before deploying.
http://www.{$DOMAIN_NAME}, https://www.{$DOMAIN_NAME} {
    redir https://{$DOMAIN_NAME}{uri} permanent
}

{$DOMAIN_NAME} {
    # Backend API
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Server-rendered rate pages and sitemap (backend/rate_pages.py).
    #
    # These paths are answered by FastAPI, not by Next and not from disk. The
    # Search Console data for Jan-Sep 2026 says the site ranks and is not
    # clicked: 87 non-brand queries at positions 4-10 returned a 0.57% CTR
    # against a ~3.5% norm, because the snippet never carries the price the
    # searcher asked for. The fix is a live rate and today's date in every
    # title, and the Next source for these routes is not in this repo
    # (docs/BLOCKED.md) -- so the pages are rendered by the backend, which does
    # deploy from here. See docs/search-console-2026-09.md.
    #
    # /gold-rates/* is now entirely the renderer's. All 15 files that used to be
    # served from /srv/static are gone: the 11 India state pages and 4 Oman city
    # pages live at the same URLs, with live prices instead of the noindex empty
    # state T1.1 left them in. An unknown /gold-rates path 404s from the backend,
    # which is correct - it does not exist.
    #
    # `handle` blocks match in order, so these win over the catch-all proxy to
    # Next. Removing a path from @rendered hands it straight back to Next, which
    # is what makes each app-route page individually reversible.
    handle /gold-rates/* {
        reverse_proxy backend:8000
    }

    @rendered path /oman-gold-prices \
                   /uae-gold-prices \
                   /qatar-gold-prices \
                   /saudi-arabia-gold-prices \
                   /bahrain-gold-prices \
                   /kuwait-gold-prices \
                   /india-gold-prices \
                   /dubai-gold-prices \
                   /abu-dhabi-gold-prices \
                   /sharjah-gold-prices \
                   /ajman-gold-prices \
                   /mumbai-gold-prices \
                   /bangalore-gold-prices \
                   /chennai-gold-prices \
                   /hyderabad-gold-prices \
                   /pune-gold-prices \
                   /sitemap.xml
    handle @rendered {
        reverse_proxy backend:8000
    }

    # Frontend Next.js
    handle /* {
        reverse_proxy frontend:3000
    }

    # Compression
    encode gzip
}
