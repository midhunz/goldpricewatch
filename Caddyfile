# Canonical host is the apex, non-www (matches the canonical tags and sitemap).
#
# SEO_TASKS T0.4 found http://www -> https://www -> https://apex, a 2-hop chain.
# Claiming both schemes for the www host here collapses it to a single 301:
# without the http:// entry, Caddy's automatic HTTPS redirect fires first and
# adds the extra hop. Keep this block ahead of the apex block.
#
# NOTE: the deployed Caddyfile already redirects www (Caddy returns a valid 301
# with a valid certificate for www), but that block is not in this file — this
# repo's config has drifted from production. Reconcile before deploying.
http://www.{$DOMAIN_NAME}, https://www.{$DOMAIN_NAME} {
    redir https://{$DOMAIN_NAME}{uri} permanent
}

{$DOMAIN_NAME} {
    # Backend API
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Server-rendered rate pages and sitemap (backend/rate_pages.py).
    #
    # These paths are answered by FastAPI, not by Next. The Search Console data
    # for Jan-Sep 2026 says the site ranks and is not clicked: 87 non-brand
    # queries at positions 4-10 returned a 0.57% CTR against a ~3.5% norm,
    # because the snippet never carries the price the searcher asked for. The
    # fix is a live rate and today's date in every title, and the Next source
    # for these routes is not in this repo (docs/BLOCKED.md) -- so the pages are
    # rendered by the backend, which does deploy from here.
    #
    # `handle` blocks match in order, so this wins over both the static file
    # server below and the catch-all proxy. Removing a path from this list hands
    # it straight back to whichever of those would have answered it, which is
    # what makes each page individually reversible.
    #
    # /sitemap.xml is here to override the compiled Next route handler, whose
    # lastmod values are all stamped at build time and six months stale (T2.7).
    @rendered path /oman-gold-prices \
                   /gold-rates/muscat.html \
                   /gold-rates/salalah.html \
                   /gold-rates/sohar.html \
                   /gold-rates/nizwa.html \
                   /gold-rates/sur.html \
                   /gold-rates/ibri.html \
                   /gold-rates/barka.html \
                   /sitemap.xml
    handle @rendered {
        reverse_proxy backend:8000
    }

    # Static state rate pages. The deploy workflow copies them to ./static on
    # the server, mounted read-only at /srv/static in docker-compose.prod.yml.
    #
    # This now covers the 11 India state pages only: the Oman city pages moved
    # to the renderer above.
    #
    # These deliberately do NOT come from the frontend image. The frontend source
    # in this repo covers only 6 of the 37 live routes, so rebuilding that image
    # would 404 28 pages (see docs/BLOCKED.md). Shipping them as plain files
    # lets fixes go out with no image build at all.
    #
    # `handle` blocks match in order, so this wins over the catch-all below and
    # the stale copies still baked into the frontend image are never reached.
    handle /gold-rates/* {
        root * /srv/static
        file_server
    }

    # Frontend Next.js
    handle /* {
        reverse_proxy frontend:3000
    }

    # Compression
    encode gzip
}
